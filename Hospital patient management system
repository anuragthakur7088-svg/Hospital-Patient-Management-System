
#include <stdio.h>

struct Patient {
    int id;
    char name[30];
    int age;
    char disease[30];
};

struct Patient p[100];
int count = 0;

int main() {
    int choice, i, id, found;

    do {
        printf("\n===== HOSPITAL PATIENT MANAGEMENT =====\n");
        printf("1. Add Patient\n");
        printf("2. Display Patients\n");
        printf("3. Search Patient\n");
        printf("4. Update Patient\n");
        printf("5. Delete Patient\n");
        printf("6. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {

        case 1:
            if (count == 100) {
                printf("Patient records are full!\n");
                break;
            }

            printf("Enter Patient ID: ");
            scanf("%d", &p[count].id);

            printf("Enter Patient Name: ");
            scanf("%29s", p[count].name);

            printf("Enter Patient Age: ");
            scanf("%d", &p[count].age);

            printf("Enter Disease: ");
            scanf("%29s", p[count].disease);

            count++;
            printf("Patient Added Successfully!\n");
            break;

        case 2:
            if (count == 0) {
                printf("No Patient Records Found!\n");
            } else {
                for (i = 0; i < count; i++) {
                    printf("\nPatient ID: %d\n", p[i].id);
                    printf("Name: %s\n", p[i].name);
                    printf("Age: %d\n", p[i].age);
                    printf("Disease: %s\n", p[i].disease);
                }
            }
            break;

        case 3:
            printf("Enter Patient ID to Search: ");
            scanf("%d", &id);
            found = 0;

            for (i = 0; i < count; i++) {
                if (p[i].id == id) {
                    printf("Patient Found!\n");
                    printf("Name: %s\n", p[i].name);
                    printf("Age: %d\n", p[i].age);
                    printf("Disease: %s\n", p[i].disease);
                    found = 1;
                    break;
                }
            }

            if (found == 0) {
                printf("Patient Not Found!\n");
            }
            break;

        case 4:
            printf("Enter Patient ID to Update: ");
            scanf("%d", &id);
            found = 0;

            for (i = 0; i < count; i++) {
                if (p[i].id == id) {
                    printf("Enter New Name: ");
                    scanf("%29s", p[i].name);

                    printf("Enter New Age: ");
                    scanf("%d", &p[i].age);

                    printf("Enter New Disease: ");
                    scanf("%29s", p[i].disease);

                    printf("Patient Updated Successfully!\n");
                    found = 1;
                    break;
                }
            }

            if (found == 0) {
                printf("Patient Not Found!\n");
            }
            break;

        case 5:
            printf("Enter Patient ID to Delete: ");
            scanf("%d", &id);
            found = 0;

            for (i = 0; i < count; i++) {
                if (p[i].id == id) {
                    for (int j = i; j < count - 1; j++) {
                        p[j] = p[j + 1];
                    }

                    count--;
                    printf("Patient Deleted Successfully!\n");
                    found = 1;
                    break;
                }
            }

            if (found == 0) {
                printf("Patient Not Found!\n");
            }
            break;

        case 6:
            printf("Thank You!\n");
            break;

        default:
            printf("Invalid Choice! Try Again.\n");
        }

    } while (choice != 6);

    return 0;
}
